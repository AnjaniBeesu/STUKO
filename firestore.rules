rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isUser(userId);
      allow delete: if isUser(userId);
      allow update: if isUser(userId) && (
        request.resource.data.username == resource.data.username
        || (
          request.resource.data.usernameChangedAt == request.time
          && (!resource.data.keys().hasAll(['usernameChangedAt'])
            || request.time >= resource.data.usernameChangedAt + duration.value(365, 'd'))
        )
      );
    }

    match /usernames/{username} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == request.resource.data.uid;
      allow delete: if signedIn() && request.auth.uid == resource.data.uid;
    }

    // Public profile wall. Anyone can read; signed-in users can post.
    match /wallPosts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.profileUid is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500;
      allow update, delete: if signedIn()
        && (resource.data.authorUid == request.auth.uid || resource.data.profileUid == request.auth.uid);
    }

    // Subject collections. Private collections are readable only by their owner.
    match /collections/{collectionId} {
      allow read: if resource.data.isPublic == true
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Reading history is public on a public profile.
    match /reads/{readId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Comments a student has made on other study notes.
    match /noteComments/{commentId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.authorUid == request.auth.uid;
    }

    // Following is visible to everyone; only the follower can create/delete their edge.
    match /follows/{followId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.followerUid == request.auth.uid
        && request.resource.data.followingUid is string
        && request.resource.data.followingUid != request.auth.uid;
      allow delete: if signedIn() && resource.data.followerUid == request.auth.uid;
      allow update: if false;
    }

    // Daily study activity powers the public Stats tab.
    match /studyActivity/{activityId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
